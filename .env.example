# Homie Drives — Environment Configuration Template
# Supabase Project URL (e.g., https://your-project-ref.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=

# Supabase Public Anon / Publishable Key
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase Service Role Key (Server-only, never expose to client)
# SUPABASE_SERVICE_ROLE_KEY=

# Google Maps Platform API Key (Dynamic Maps JavaScript API)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# =============================================================================
# THIRD-PARTY INTEGRATION APIS (Setu / SurePass, Razorpay / Cashfree, Twilio / Gupshup)
# If unconfigured, Homie Drives deterministically falls back to sandbox simulation.
# =============================================================================

# 1. DigiLocker & Identity Verification (Setu or SurePass)
# Setu DigiLocker Gateway credentials: https://setu.co
SETU_DIGILOCKER_CLIENT_ID=
SETU_DIGILOCKER_CLIENT_SECRET=
SETU_DIGILOCKER_PRODUCT_INSTANCE_ID=
# Alternative: SurePass API Token: https://surepass.io
SUREPASS_API_TOKEN=

# 2. Payment Gateway & Security Deposit Escrow (Razorpay or Cashfree)
# Razorpay API Keys: https://dashboard.razorpay.com
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
NEXT_PUBLIC_RAZORPAY_KEY_ID=
# Alternative: Cashfree Escrow & Payouts: https://cashfree.com
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=

# 3. Transactional Comms, SMS & WhatsApp Business API (Twilio or Gupshup)
# Twilio credentials: https://console.twilio.com
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_WHATSAPP_NUMBER=
# Alternative: Gupshup Enterprise WhatsApp API: https://www.gupshup.io
GUPSHUP_API_KEY=
GUPSHUP_APP_NAME=

